#include <winver.h>

101 ICON "TinySpeak.ico"

1 VERSIONINFO
 FILEVERSION 0,0,0,18
 PRODUCTVERSION 0,0,0,18
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "TinySpeak"
            VALUE "FileVersion", "Patch 18"
            VALUE "ProductName", "TinySpeak"
            VALUE "ProductVersion", "Patch 18"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
