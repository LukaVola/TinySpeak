#include <winver.h>

101 ICON "TinySpeak.ico"

1 VERSIONINFO
 FILEVERSION 0,0,0,14
 PRODUCTVERSION 0,0,0,14
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "TinySpeak"
            VALUE "FileVersion", "Patch 14"
            VALUE "ProductName", "TinySpeak"
            VALUE "ProductVersion", "Patch 14"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
